{
  "name": "easy-currencies",
  "version": "1.8.3",
  "description": "A tool for easy conversion of currencies.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "docs": "typedoc && cp ./_config.yml docs/_config.yml",
    "prepublishOnly": "npm test",
    "test": "jest --selectProjects offline",
    "test:live": "jest --selectProjects live --passWithNoTests --runInBand",
    "test:all": "jest --passWithNoTests",
    "test:coverage": "jest --selectProjects offline --coverage",
    "api:check": "npm run build && api-extractor run",
    "api:update": "npm run build && api-extractor run --local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scharkee/easy-currencies.git"
  },
  "keywords": [
    "currency",
    "currencies",
    "conversion",
    "exchange",
    "rates",
    "api",
    "converter"
  ],
  "author": "Scharkee",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Scharkee/easy-currencies/issues"
  },
  "homepage": "https://github.com/Scharkee/easy-currencies#readme",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "axios": "^1.7.2"
  }
}
