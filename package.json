{
  "name": "easy-currencies",
  "version": "2.1.0",
  "description": "A tool for easy conversion of currencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src test scripts && eslint src",
    "prepare": "npm run build",
    "docs": "typedoc && cp ./_config.yml docs/_config.yml",
    "prepublishOnly": "npm run build && npm test && npm run api:check",
    "test": "jest --selectProjects offline",
    "test:live": "jest --selectProjects live --passWithNoTests --runInBand",
    "test:all": "jest --passWithNoTests",
    "test:coverage": "jest --selectProjects offline --coverage",
    "api:check": "npm run build && api-extractor run",
    "api:update": "npm run build && api-extractor run --local",
    "lint:package": "publint",
    "check:package": "attw --pack .",
    "pretest": "npm run build",
    "smoke:pack": "node scripts/smoke-test-tarball.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rastenis/easy-currencies.git"
  },
  "keywords": [
    "currency",
    "currencies",
    "conversion",
    "exchange",
    "rates",
    "api",
    "converter"
  ],
  "author": "rastenis",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rastenis/easy-currencies/issues"
  },
  "homepage": "https://github.com/rastenis/easy-currencies#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "dotenv": "^16.4.5",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "ts-jest": "^29.1.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0"
  }
}
